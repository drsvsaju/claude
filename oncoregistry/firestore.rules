rules_version = '2';

// ============================================================================
// OncoRegistry — Firestore security rules
//
// Layout
//   studies/{sid}                     study settings + team (roles map)
//   studies/{sid}/patients/{pid}      one document per patient (pid = Study ID, e.g. BRCA-0007)
//   studies/{sid}/audit/{id}          append-only audit trail (who changed what, when)
//   invites/{sid}_{email}             pending invitation for an e-mail address
//
// Roles (studies/{sid}.roles[uid]):
//   admin  — principal investigator: settings, team, verify/lock, delete
//   editor — data entry: register and edit patients (not locked records)
//   viewer — read-only (e.g. statistician): view, dashboard, export
//
// Every request needs a signed-in user with a VERIFIED e-mail address, so an
// invitation can only be accepted by the person who owns that inbox.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.uid; }
    function myEmail() { return request.auth.token.email.lower(); }
    function studyPath(sid) { return /databases/$(database)/documents/studies/$(sid); }
    function roleIn(sid) { return get(studyPath(sid)).data.roles.get(me(), ''); }
    function isMember(sid) { return signedIn() && roleIn(sid) in ['admin', 'editor', 'viewer']; }
    function canEdit(sid) { return signedIn() && roleIn(sid) in ['admin', 'editor']; }
    function isAdmin(sid) { return signedIn() && roleIn(sid) == 'admin'; }
    // Two lists hold the same items.
    function sameSet(a, b) { return a.hasOnly(b) && b.hasOnly(a); }

    // ---------------------------------------------------------------- studies
    match /studies/{sid} {
      allow get: if signedIn() && resource.data.roles.get(me(), '') != '';
      allow list: if signedIn() && me() in resource.data.memberUids;
      allow create: if signedIn() && validStudy(request.resource.data)
        && request.resource.data.roles.keys().hasOnly([me()])
        && request.resource.data.roles[me()] == 'admin'
        && request.resource.data.ownerUid == me()
        && request.resource.data.counter == 0
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && validStudy(request.resource.data) && (
           adminUpdate() || counterBump() || joinViaInvite(sid) || leaveStudy());
      allow delete: if false;
    }

    function validStudy(d) {
      return d.keys().hasOnly(['name', 'code', 'desc', 'pi', 'iec', 'iecDate', 'sites', 'target', 'mrnLookup', 'mrnSalt',
                               'sections', 'custom', 'roles', 'memberUids', 'people', 'ownerUid', 'counter', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.code is string && d.code.matches('^[A-Z0-9]{2,8}$')
        && d.roles is map && d.roles.values().hasOnly(['admin', 'editor', 'viewer'])
        && d.memberUids is list && sameSet(d.memberUids, d.roles.keys())
        && d.people is map
        && d.counter is int && d.counter >= 0
        && d.mrnSalt is string;
    }
    // Admins manage everything except the identity fields and the ID counter; one admin must remain.
    function adminUpdate() {
      let d = request.resource.data;
      let r = resource.data;
      return r.roles.get(me(), '') == 'admin'
        && d.code == r.code && d.ownerUid == r.ownerUid && d.createdAt == r.createdAt
        && d.mrnSalt == r.mrnSalt && d.counter == r.counter
        && d.roles.values().hasAny(['admin']);
    }
    // Registering a patient: any admin/editor takes the next Study ID number.
    function counterBump() {
      let d = request.resource.data;
      let r = resource.data;
      return r.roles.get(me(), '') in ['admin', 'editor']
        && d.diff(r).affectedKeys().hasOnly(['counter'])
        && d.counter == r.counter + 1;
    }
    // Accepting an invitation: add only myself, with exactly the invited role.
    function joinViaInvite(sid) {
      let d = request.resource.data;
      let r = resource.data;
      let inv = /databases/$(database)/documents/invites/$(sid + '_' + myEmail());
      return !(me() in r.roles) && exists(inv)
        && d.diff(r).affectedKeys().hasOnly(['roles', 'memberUids', 'people'])
        && d.roles.diff(r.roles).affectedKeys().hasOnly([me()])
        && d.people.diff(r.people).affectedKeys().hasOnly([me()])
        && d.roles[me()] == get(inv).data.role;
    }
    // Leaving a study: remove only myself; an admin must remain.
    function leaveStudy() {
      let d = request.resource.data;
      let r = resource.data;
      return me() in r.roles && !(me() in d.roles)
        && d.diff(r).affectedKeys().hasOnly(['roles', 'memberUids', 'people'])
        && d.roles.diff(r.roles).affectedKeys().hasOnly([me()])
        && d.people.diff(r.people).affectedKeys().hasOnly([me()])
        && d.roles.values().hasAny(['admin']);
    }

    // --------------------------------------------------------------- patients
    match /studies/{sid}/patients/{pid} {
      allow read: if isMember(sid);
      allow create: if canEdit(sid) && validPatient(request.resource.data)
        && request.resource.data.locked == false
        && request.resource.data.rev == 1
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.sid == pid
        && getAfter(studyPath(sid)).data.counter == request.resource.data.seq
        && pid.matches(getAfter(studyPath(sid)).data.code + '-[0-9]+');
      // rev must go up by exactly one: a save based on an out-of-date copy is refused
      // instead of silently overwriting a colleague's newer changes.
      allow update: if canEdit(sid) && validPatient(request.resource.data)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['sid', 'seq', 'createdBy', 'createdByName', 'createdAt'])
        && (isAdmin(sid) || (
              resource.data.locked == false && request.resource.data.locked == false
              && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['verifiedBy', 'verifiedByName', 'verifiedAt'])));
      allow delete: if isAdmin(sid);
    }

    function validPatient(d) {
      return d.keys().hasOnly(['sid', 'seq', 'status', 'locked', 'd', 'rep', 'comp', 'rev', 'mrnHash',
                               'createdBy', 'createdByName', 'createdAt', 'updatedBy', 'updatedByName', 'updatedAt',
                               'verifiedBy', 'verifiedByName', 'verifiedAt'])
        && d.sid is string && d.seq is int
        && d.status in ['draft', 'complete']
        && d.locked is bool
        && d.d is map && d.rep is map
        && d.rev is int
        && d.mrnHash is string
        && d.updatedBy == me()
        && d.updatedAt == request.time;
    }

    // ------------------------------------------------------------ audit trail
    match /studies/{sid}/audit/{aid} {
      allow read: if isMember(sid);
      allow create: if canEdit(sid)
        && request.resource.data.keys().hasOnly(['pid', 'action', 'by', 'byName', 'at', 'changes', 'note'])
        && request.resource.data.by == me()
        && request.resource.data.at == request.time
        && request.resource.data.action in ['create', 'update', 'complete', 'reopen', 'lock', 'unlock', 'delete'];
      allow update, delete: if false;
    }

    // ------------------------------------------------------------ invitations
    match /invites/{iid} {
      allow read: if signedIn() && (resource.data.email == myEmail() || isAdmin(resource.data.studyId));
      allow create: if signedIn() && isAdmin(request.resource.data.studyId)
        && request.resource.data.keys().hasOnly(['studyId', 'studyName', 'email', 'role', 'invitedBy', 'invitedByName', 'createdAt'])
        && iid == request.resource.data.studyId + '_' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['admin', 'editor', 'viewer']
        && request.resource.data.invitedBy == me()
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.email == myEmail() || isAdmin(resource.data.studyId));
    }
  }
}
